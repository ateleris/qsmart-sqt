# Copy to .env and fill in. Do NOT commit .env.

# Repo this runner registers to.
REPO_URL=https://github.com/<org>/ats-sqt

# Personal Access Token used by the runner to fetch registration tokens.
#   - Classic PAT: `repo` scope.
#   - Fine-grained PAT: repo Administration -> Read and write.
# Registration tokens from the GitHub UI expire in ~1h and won't survive
# restarts; a PAT lets the ephemeral runner re-register unattended.
ACCESS_TOKEN=

# Optional overrides.
RUNNER_NAME=ats-sqt-dind
RUNNER_LABELS=self-hosted,dind
