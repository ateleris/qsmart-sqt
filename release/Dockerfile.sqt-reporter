# SQT Orchestrator image. The binary is static (musl, rustls with bundled
# webpki roots), so the image holds nothing else.
#
# Build context: a directory containing the release binary `sqt-reporter`
# `LICENSE` and `NOTICE` (see ci/release-images.sh).
FROM scratch
COPY LICENSE NOTICE /usr/share/doc/sqt/
COPY sqt-reporter /usr/local/bin/sqt-reporter
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/sqt-reporter"]
